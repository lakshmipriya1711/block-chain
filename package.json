{
  "name": "academic-verifier",
  "version": "1.0.0",
  "private": true,
  "description": "Trust infrastructure for academic credentials.",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite --host 127.0.0.1 --config frontend/vite.config.js",
    "dev:backend": "node backend/server.js",
    "build": "vite build --config frontend/vite.config.js",
    "test": "hardhat test",
    "deploy": "hardhat run scripts/deploy.js --network localhost",
    "start": "node backend/server.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "hardhat": "^2.22.18",
    "vite": "^6.0.7"
  }
}
